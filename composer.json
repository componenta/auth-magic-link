{
    "name": "componenta/auth-magic-link",
    "description": "Pre-auth-bound magic-link authentication for Componenta Auth 3",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/auth": "^3.0",
        "componenta/auth-http": "^1.0",
        "componenta/auth-session": "^1.0",
        "componenta/auth-session-http": "^1.0",
        "componenta/auth-token": "^1.0",
        "componenta/identity": "^1.0.1",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Auth\\MagicLink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Auth\\MagicLink\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/componenta/auth.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/componenta/auth-http.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/componenta/auth-session.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/componenta/auth-session-http.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/componenta/auth-token.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max",
        "check": [
            "@phpstan",
            "@test"
        ]
    }
}
